/target
node_modules
.playwright-mcp/

# Build output: both wasm bundles are regenerated by scripts/deploy.sh.
/site/assets/wasm/
/site/assets/wasm-run/
__pycache__/
*.pyc

# Build output: scripts/build-scripts.mjs compiles these from site/src/*.ts.
/site/assets/theme.js
/site/assets/site.js
/site/assets/examples.js
/site/assets/play-worker.js
/site/assets/compile-worker.js

# Generated by scripts/build-docs.py from the language repository's docs.
/site/learn/
/site/ko/learn/

# Screenshots taken while checking the design.
*.png

# Local contributor and AI-assistant instructions — never site data.
# The owner has asked twice that none of this can reach a commit.
**/CLAUDE.md
**/claude.md
**/AGENT.md
**/AGENTS.md
**/agent.md
**/agents.md
**/GEMINI.md
**/CODEX.md
**/PLAN.md
**/plan.md
**/DEV-LOG.md
**/dev-log.md
**/AI.md
**/.claude/
**/.codex/
**/.agents/
**/.cursor/
**/.cursorrules
**/.windsurf/
**/.aider*
**/copilot-instructions.md

# Wrangler's local cache. It writes the Cloudflare account id into
# .wrangler/cache/pages.json, which has no business being in a public repository.
.wrangler/

# Secrets. Deploy credentials live in the shell environment, never in a file here.
.env
.env.*
.dev.vars
.dev.vars.*
*.key
*.pem
*.log

# Plain-text prompts, written by scripts/build-docs.py from the language repo.
/site/assets/prompts/
